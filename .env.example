# Autonomous signing is OFF by default. Only enable it for a dedicated, low-balance agent wallet.
ENABLE_AUTONOMOUS_SIGNING=false

# Never use your primary wallet here. Store any private key only in your deployment secret store.
# AGENT_PRIVATE_KEY=
# SOLANA_PRIVATE_KEY=

# Solana RPC. Public mainnet RPC is the default; use a trusted provider if needed.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Collector Crypt Gacha API. Set to the development API for safe integration testing.
COLLECTOR_CRYPT_GACHA_API_BASE_URL=https://dev-gacha.collectorcrypt.com
# Optional partner credential for Collector Crypt Gacha API (server-side only).
COLLECTOR_CRYPT_GACHA_API_KEY=

